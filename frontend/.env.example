# API base URL (Vite dev proxy forwards /api to this target)
VITE_API_URL=/api
VITE_BACKEND_URL=http://localhost:8001

# Base Sepolia (testnet only)
VITE_BASE_SEPOLIA_RPC=https://sepolia.base.org
VITE_BASE_SEPOLIA_EXPLORER_URL=https://sepolia.basescan.org
VITE_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Wallet auth message domain
VITE_WALLET_AUTH_DOMAIN=localhost:3000

# WalletConnect Cloud project ID (https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your-project-id

# Demo transfer cap in USDC
VITE_DEMO_TRANSFER_CAP_USDC=1000.00
